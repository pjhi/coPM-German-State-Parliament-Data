			<int key="ReihNr" value="1" />
			<string key="DokArt" value="Drs" />
			<string key="DokArtL" value="Drucksache" />
			<string key="DokTypL" value="Gesetzentwurf" />
			<string key="Desk" value="Schulgesetz für Baden-Württemberg" />
			<string key="Titel" value="Gesetz zur Änderung des Schulgesetzes für Baden-Württemberg und des Landesbesoldungsgesetzes Baden-Württemberg" />
			<string key="DokNr" value="16/7603" />
			<string key="Abstract" value='Verschiebung des verpflichtenden Stichtags für die Einschulung von Grundschulkindern; Überführung bestimmter Schulversuche an den allgemein bildenden Gymnasien in die gesetzliche Regelphase; Klarstellung zum Einsatz informationstechnisch gestützter Systeme für die Erfüllung des Auftrags der Schule in einer digitalisierten Welt; Regelung der Erweiterung der Bestimmungen zum Bildungsmonitoring und der damit verbundenen Aufgaben der Schulen sowie der Schulaufsicht; Verpflichtung der öffentlichen Schulen zur Nutzung der landeseinheitlichen Schulverwaltungssoftware "Amtliche Schulverwaltung Baden-Württemberg"; Änderung bei der regionalen Schulentwicklung an den auf der Grundschule aufbauenden Schulen hinsichtlich des Hinweises auf das Unterschreiten von Mindestschülerzahlen in der Eingangsklasse; künftige Steuerung der Seminare für Ausbildung und Fortbildung der Lehrkräfte durch das Zentrum für Schulqualität und Lehrerbildung und dessen Regionalstellen; Aufgabenverlagerung mit Änderungen in der Personal- und der Besoldungsstruktur der Seminare für Ausbildung und Fortbildung der Lehrkräfte' />
			<string key="Urheber" value="Landesregierung" />
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP16/Drucksachen/7000/16_7603_D.pdf" />
