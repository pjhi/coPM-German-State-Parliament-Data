			<string key="Desk" value="Erneuerbare Energie" />
			<string key="Titel" value="Gesetz zur Nutzung erneuerbarer Wärmeenergie in Baden-Württemberg (Erneuerbare Wärme-Gesetz &amp;minus; EWärmeG)" />
			<string key="DokNr" value="14/1781" />
			<string key="Abstract" value="Einführung einer Nutzungspflicht von 20 Prozent für erneuerbare Energien in Neubauten und 10 Prozent in Wohngebäuden im Bestand, Bestimmung der Möglichkeiten zur ersatzweisen Erfüllung, Vorlage eines Berichts über den Stand der Umsetzung bis 1. April 2011; Regelung von Nachweis- und Hinweispflichten sowie der Ahndung von Verstößen als Ordnungswidrigkeit mit Geldbuße, Bestimmung der unteren Baurechtsbehörde als zuständig für die Überwachung und Sanktionierung" />
			<string key="Urheber" value="Landesregierung" />
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP14/Drucksachen/1000/14_1781_D.pdf" />
