			<string key="DokTypL" value="Gesetzentwurf" />
			<string key="Desk" value="Wahlrecht" />
			<string key="Titel" value="Gesetz über das Wahl- und Stimmrecht von Personen, für die zur Besorgung aller ihrer Angelegenheiten ein Betreuer bestellt ist" />
			<string key="DokNr" value="16/5914" />
			<string key="Abstract" value="Übergangsregelung für die Nicht-Anwendung von Wahlrechtsausschlüssen im Landtags- und Kommunalwahlrecht von Baden-Württemberg bis zur vom Bundesverfassungsgericht verlangten erfolgten Neuregelung im Bundestagswahlrecht, insbesondere Nicht-Anwendung der Wahlrechtsausschlüsse für Personen mit bestelltem Betreuer für die Besorgung aller ihrer Angelegenheiten für die Kommunalwahlen und die Wahl der Regionalversammlung des Verbands Region Stuttgart am 26. Mai 2019 sowie für Bürgermeisterwahlen und für Abstimmungen auf Gemeindeebene; Aussetzung der Wahl- und Stimmrechtsausschlüsse dieser Personen für das Wahlrecht zum Landtag und in dessen Folge auch für Volksanträge, Volksbegehren und Volksabstimmungen" />
			<string key="Urheber" value="['BÜNDNIS 90/DIE GRÜNEN (GRÜNE)', 'Christlich-Demokratische Union (CDU)']" />
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP16/Drucksachen/5000/16_5914_D.pdf" />
