			<int key="ReihNr" value="1" />
			<string key="DokArt" value="Drs" />
			<string key="DokArtL" value="Drucksache" />
			<string key="DokTypL" value="Gesetzentwurf" />
			<string key="Desk" value="Landesheimgesetz" />
			<string key="Titel" value="Heimgesetz für Baden-Württemberg (Landesheimgesetz &amp;minus; LHeimG)" />
			<string key="DokNr" value="14/2535" />
			<string key="Abstract" value="Qualitätssicherung in Pflegeeinrichtungen, Ermöglichung neuer Wohnformen, Klarstellung des Heimbegriffs, Vereinfachung und Entbürokratisierung, Stärkung der Interessen und Schutz der Heimbewohner; Änderung des Landesverwaltungsgesetzes sowie der Verordnung über Zuständigkeiten nach dem Gesetz über Ordnungswidrigkeiten, Außerkrafttreten verschiedener Rechtsverordnungen, und zwar der Heimverordnung, der Verordnung über Zuständigkeit nach dem Heimgesetz, der Verordnung über die Gewährung von Mehrleistungen zu den Geldleistungen der gesetzlichen Unfallversicherung im Bereich der Ausführungsbehörden für Unfallversicherung des Landes, der Verordnung über die Zuständigkeit für die Unfalluntersuchung in Bergbauunternehmen, der Verordnung über die Höchstgrenze des Jahresarbeitsverdienstes in der gesetzlichen Unfallversicherung, der Verordnung über die Anpassung der Bezirke der allgemeinen Ortskrankenkassen an die Kreisgrenzen vom 13. November 1973, der Verordnung über die Bestellung von Vollstreckungs- und Vollziehungsbeamten bei den Trägern der Sozialversicherung" />
			<string key="Urheber" value="Landesregierung" />
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP14/Drucksachen/2000/14_2535_D.pdf" />
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 19.03.2008 Drucksache 14/2535  (63 S.)" />
			<string key="Sb" value="nan" />
			<string key="Redner" value="nan" />
