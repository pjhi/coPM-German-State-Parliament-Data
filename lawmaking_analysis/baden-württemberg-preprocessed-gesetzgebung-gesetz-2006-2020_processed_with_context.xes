			<string key="DokArtL" value="Drucksache" />
			<string key="DokTypL" value="Gesetzentwurf" />
			<string key="Desk" value="Privatschule" />
			<string key="Titel" value="Gesetz zur Änderung des Privatschulgesetzes und dessen Vollzugsverordnung" />
			<string key="DokNr" value="16/2333" />
			<string key="Abstract" value="Umsetzung des Urteils des Verfassungsgerichtshofs vom 6. Juli 2015 zur staatlichen Förderung von privaten Ersatzschulen sowie der Erhöhung der Kopfsatzzuschüsse für private Schulen, insbesondere Konkretisierung des Ausgleichsanspruchs für nicht erhobenes Schulgeld, Erhöhung der Kopfsatzzuschüsse auf 80 Prozent der Bruttokosten eines Schülers, gesetzliche Verankerung des Kostendeckungsgrads von 80 Prozent, klarstellende Regelungen zur Abgrenzung von Außenstellen und der Genehmigung neuer Ersatzschulen sowie zu den Voraussetzungen für die staatliche Anerkennung" />
			<string key="Urheber" value="Landesregierung" />
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP16/Drucksachen/2000/16_2333_D.pdf" />
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 11.07.2017 Drucksache 16/2333 (42 S.)" />
