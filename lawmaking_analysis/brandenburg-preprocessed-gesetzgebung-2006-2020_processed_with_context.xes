			<string key="Titel" value="Siebentes Gesetz zur Änderung des Brandenburgischen Finanzausgleichsgesetzes" />
			<string key="DokNr" value="06/9192" />
			<string key="Su" value="44" />
			<string key="Urheber" value="Landesregierung" />
			<string key="LokURL" value="['https://www.parlamentsdokumentation.brandenburg.de/parladoku/w6/drs/ab_9100/9192.pdf', 'https://www.parlamentsdokumentation.brandenburg.de/parladoku/w6/drs/ab_9100/9192.docx']" />
			<string key="FundSt" value="Brandenburg -  Gesetzentwurf (LReg) 16.07.2018 Drucksache 6/9192 (44 S.)" />
			<string key="NrInTyp" value="nan" />
			<string key="Sb" value="nan" />
			<string key="BText" value="nan" />
			<string key="Redner" value="nan" />
			<string key="VkDat" value="NaT" />
			<string key="HNr" value="nan" />
			<string key="Jg" value="NaT" />
			<string key="Abstract" value="Artikel 1: Änderung des Brandenburgischen Finanzausgleichsgesetzes (Regelungen aufgrund der Neuordnung  des bundesstaatlichen Finanzausgleichs, v.a. bzgl. der investiven Schlüsselzuweisungen und der Zusammensetzung der Verbundgrundlagen; stufenweise Anhebung der Verbundquote von 20 auf 22,43 Prozent im Jahr 2021; Erhöhung der Theater- und Orchesterpauschale um 5 Mio. Euro auf 22 Mio. Euro jährlich ab dem Ausgleichsjahr 2019; Stärkung des Soziallastenausgleichs um 60 Mio. Euro jährlich und Finanzierung des Jugendhilfelastenausgleichs mit 20 Mio. Euro jährlich aus der Vorwegentnahme ab dem Ausgleichsjahr 2019; Beteiligung der Verbandsgemeinde am kommunalen Finanzausgleich; Auszahlung des Schullastenausgleichs; Finanzierung der Studiengänge „Öffentliche Verwaltung Brandenburg (ÖVBB)“ und „Verwaltungsinformatik Brandenburg (VWI)“ über den Ausgleichsfonds; Aktualisierung des Fallgruppenkatalogs des Ausgleichsfonds zur Gewährleistung der finanziellen Mindestausstattung aller Kommunen) Artikel 2: Inkrafttreten, Außerkrafttreten (Außerkrafttreten der jährlichen Gemeindefinanzierungsgesetze Nummer 1 bis 13 zum Zwecke der Rechtsbereinigung)" />
			<string key="concept:name" value="Gesetzentwurf" />
			<int key="@@index" value="65875" />
			<date key="DokDat" value="2018-07-16T00:00:00+00:00" />
			<date key="DokDat_original" value="2018-07-16T00:00:00+00:00" />
		</event>
