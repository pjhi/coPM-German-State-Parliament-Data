			<string key="DokNr" value="06/8594" />
			<string key="Su" value="119" />
			<string key="Urheber" value="Landesregierung" />
			<string key="LokURL" value="https://www.parlamentsdokumentation.brandenburg.de/parladoku/w6/drs/ab_8500/8594.pdf" />
			<string key="FundSt" value="Brandenburg -  Gesetzentwurf (LReg) 17.04.2018 Drucksache 6/8594 (119 S.)" />
			<string key="NrInTyp" value="nan" />
