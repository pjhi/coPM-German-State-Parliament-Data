			<string key="Desk" value="Grunderwerbsteuer" />
			<string key="Titel" value="Gesetz über die Festsetzung des Steuersatzes für die Grunderwerbsteuer" />
			<string key="DokNr" value="15/497" />
			<string key="Abstract" value='Erhöhung der Grunderwerbsteuer von bisher 3,5 Prozent auf 5 Prozent der Bemessungsgrundlage; durch die zu erwartenden Mehreinnahmen soll die Nettokreditaufnahme des Landes begrenzt und der vorgesehene "Pakt mit den Kommunen für Familien mit Kindern" verwirklicht werden; Anpassung des Anteils der Stadt- und Landkreise entsprechend der Höhe der Bemessungsgrenze; Verbleib der Steuermehreinnahmen im Land, da die Erhöhung des Steuersatzes den Länderfinanzausgleich nicht berührt' />
			<string key="Urheber" value="Landesregierung" />
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP15/Drucksachen/0000/15_0497_D.pdf" />
