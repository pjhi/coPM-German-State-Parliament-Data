			<string key="Desk" value="Sorben" />
			<string key="Titel" value="Gesetz zur Änderung von Rechtsvorschriften über die Rechte der Sorben/Wenden im Land Brandenburg" />
			<string key="DokNr" value="05/5401" />
			<string key="Su" value="39" />
			<string key="Urheber" value="['Kircheis, Kerstin (SPD)', 'Lipsdorf, Jens (FDP)', 'Maresch, Jürgen (DIE LINKE)', 'Schier, Roswitha (CDU)', 'Schierack, Prof. Dr. Michael (CDU)', 'Schippel, Werner-Siegwart (SPD)', 'Schulz-Höpfner, Monika (CDU)', 'Senftleben, Ingo (CDU)', 'Wöllert, Birgit (DIE LINKE)']" />
			<string key="LokURL" value="https://www.parlamentsdokumentation.brandenburg.de/parladoku/w5/drs/ab_5400/5401.pdf" />
			<string key="FundSt" value="Brandenburg -  Gesetzentwurf Kerstin Kircheis (SPD), Jens Lipsdorf (FDP), Jürgen Maresch (DIE LINKE), Roswitha Schier (CDU), Prof. Dr. Michael Schierack (CDU), Werner-Siegwart Schippel (SPD), Monika Schulz-Höpfner (CDU), Ingo Senftleben (CDU), Birgit Wöllert (DIE LINKE) 25.05.2012 Drucksache 5/5401 (39 S.)" />
			<string key="NrInTyp" value="nan" />
			<string key="Sb" value="nan" />
			<string key="BText" value="nan" />
			<string key="Redner" value="nan" />
			<string key="VkDat" value="NaT" />
			<string key="HNr" value="nan" />
			<string key="Jg" value="NaT" />
			<string key="Abstract" value='Artikel 1: Änderung des Sorben(Wenden)-Gesetzes; Artikel 2: Änderung des Wahlkampfkostenerstattungsgesetzes; Artikel 3: Änderung des Brandenburgischen Landeswahlgesetzes; Artikel 4: Änderung des Verwaltungsverfahrensgesetzes für das Land Brandenburg; Artikel 5: Änderung der Kommunalverfassung des Landes Brandenburg; Artikel 6: Änderung des Brandenburgischen Schulgesetzes; Artikel 7: Änderung des Brandenburgischen Lehrerbildungsgesetzes; Artikel 8: Änderung des Kindertagesstättengesetzes; Artikel 9: Änderung des Gesetzes zur Regionalplanung und zur Braunkohlen- und Sanierungsplanung; Artikel 10: Änderung des Gesetzes zur Förderung der Braunkohle im Land Brandenburg, Artikel 11: Bekanntmachungserlaubnis; Artikel 12: Inkrafttreten (siehe auch Vorgang "Novellierung des Gesetzes zur Ausgestaltung der Rechte der Sorben (Wenden) im Land Brandenburg" im Rat für sorbische/wendische Angelegenheiten) Die Abgeordneten Roswitha Schier (CDU), Prof. Dr. Michael Schierack (CDU), Monika Schulz-Höpfner (CDU) und Ingo Senftleben (CDU) haben mit Schreiben vom 06.12.2013 ihre Einbringerschaft zurückgezogen.' />
			<string key="concept:name" value="Gesetzentwurf" />
			<int key="@@index" value="128049" />
			<date key="DokDat" value="2012-05-25T00:00:00+00:00" />
