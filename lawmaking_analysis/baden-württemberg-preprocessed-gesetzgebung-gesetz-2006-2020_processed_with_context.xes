			<string key="@id" value="D-123984" />
			<int key="ReihNr" value="1" />
			<string key="DokArt" value="Drs" />
			<string key="DokArtL" value="Drucksache" />
			<string key="DokTypL" value="Gesetzentwurf" />
			<string key="Desk" value="Abgeordnetengesetz (Baden-Württemberg)" />
			<string key="Titel" value="Gesetz zur Änderung des Abgeordnetengesetzes und des Gesetzes über die Rechtsstellung und Finanzierung der Fraktionen im Landtag von Baden-Württemberg" />
			<string key="DokNr" value="16/5040" />
			<string key="Abstract" value="Verbesserung der Sicherheit des Landtags, seiner Einrichtungen und der dort beschäftigten Personen, insbesondere Sicherstellung des Vertrauens der Bevölkerung in eine nachvollziehbare Verwendung öffentlicher Mittel bei der Erstattung der Aufwendungen für Abgeordnetenmitarbeiter, obligatorische Vorlage eines Führungszeugnisses der Mitarbeiter und Praktikanten von Abgeordneten vor Beginn des Arbeitsverhältnisses, Ablehnung der Erstattung von Aufwendungen bei Eintrag einer Vorsatzstraftat im Führungszeugnis sowie einer befürchteten Gefährdung parlamentarischer Schutzgüter nach Abwägung aller Umstände im Einzelfall, Miteinbeziehung der zum Zeitpunkt des Inkrafttretens dieses Gesetzes bereits beschäftigten Mitarbeiter und Praktikanten der Abgeordneten in diese Regelung, Aufnahme einer wirkungsgleichen Regelung in das Fraktionsgesetz und Schaffung einer Kürzungsvorschrift mit bestimmten Auskunftspflichten für die pauschal gezahlten Fraktionszuschüsse" />
			<string key="Urheber" value="['BÜNDNIS 90/DIE GRÜNEN (GRÜNE)', 'Christlich-Demokratische Union (CDU)', 'Sozialdemokratische Partei Deutschlands (SPD)', 'Freie Demokratische Partei / Demokratische Volkspartei (FDP/DVP)']" />
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP16/Drucksachen/5000/16_5040_D.pdf" />
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Fraktion GRÜNE, Fraktion der CDU, Fraktion der SPD, Fraktion der FDP/DVP 18.10.2018 Drucksache 16/5040  (7 S.)" />
