			<string key="Titel" value="Gesetz zur Änderung des Heilberufsgesetzes und weiterer Gesetze" />
			<string key="DokNr" value="06/8422" />
			<string key="Su" value="56" />
			<string key="Urheber" value="Landesregierung" />
			<string key="LokURL" value="https://www.parlamentsdokumentation.brandenburg.de/parladoku/w6/drs/ab_8400/8422.pdf" />
			<string key="FundSt" value="Brandenburg -  Gesetzentwurf (LReg) 22.03.2018 Drucksache 6/8422 (56 S.)" />
			<string key="NrInTyp" value="nan" />
			<string key="Sb" value="nan" />
			<string key="BText" value="nan" />
			<string key="Redner" value="nan" />
			<string key="VkDat" value="NaT" />
			<string key="HNr" value="nan" />
			<string key="Jg" value="NaT" />
			<string key="Abstract" value='Artikel 1: Änderung des Heilberufsgesetzes (Einfügung von Paragrafenbezeichnungen; Anpassung an veränderte Rahmenbedingungen für berufsständische Selbstverwaltungskörperschaften der Heilberufe, u.a.: Verlängerung der Wahlperiode der Kammerversammlung, Anpassung des Verhältnisschlüssels Kammermitglieder zu Delegierten, Bekanntgabe von Satzungen und Beschlüssen im Internet, Präzisierungen der Berufspflichten bzw. der Kammeraufgaben im Bereich der Berufshaftpflichtversicherung, Möglichkeit zur Festsetzung von Zwangsgeldern bei Berufsrechtsverstößen, Einführung des "Tatortprinzips" bei berufsrechtlichen Verstößen; Klarstellungen bzgl. der Regelungen zur Ethikkommission, der Ehrenamtlichkeit der Tätigkeit von Kammermitgliedern sowie der Kostenerstattung für die Gutachterstelle nach dem Gesetz über die freiwillige Kastration und andere Behandlungsmethoden);  Artikel 2: Änderung des Brandenburgischen Justizkostengesetzes (Aktualisierung von Verweisungen);  Artikel 3: Änderung des Brandenburgischen Steuerberaterversorgungsgesetzes (Anpassungen hinsichtlich der Ehrenamtlichkeit der Funktionsträger, der Anforderungen an die Datenschutz-Grundverordnung und der Einvernehmensregelung bei Satzungsgenehmigungen);  Artikel 4: Änderung des Brandenburgischen Beamtenversorgungsgesetzes (Angabe des Familienstandes für die Berechnung der Versorgungsausgaben);  Artikel 5: Änderung der Landeshaushaltsordnung (Anpassung zur Gleichstellung der Vergabearten "Öffentliche Ausschreibung" sowie "Beschränkte Ausschreibung mit Teilnahmewettbewerb");  Artikel 6: Änderung des Brandenburgischen Krankenhausentwicklungsgesetzes (Ergänzung bei der Qualitätssicherung in der stationären Versorgung); Artikel 7: Bekanntmachungserlaubnis;  Artikel 8: Inkrafttreten' />
			<string key="concept:name" value="Gesetzentwurf" />
			<int key="@@index" value="63827" />
			<date key="DokDat" value="2018-03-22T00:00:00+00:00" />
			<date key="DokDat_original" value="2018-03-22T00:00:00+00:00" />
		</event>
