			<string key="FundSt" value="Brandenburg -  Gesetzentwurf Prof. Dr. Ulrike Liedtke (Präsidentin des Landtages Brandenburg) 29.11.2019 Drucksache 7/247 (10 S.)" />
			<string key="NrInTyp" value="nan" />
