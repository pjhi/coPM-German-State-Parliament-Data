			<string key="DokArtL" value="Drucksache" />
			<string key="DokTypL" value="Gesetzentwurf" />
			<string key="Desk" value="Gemeindefinanzen" />
			<string key="Titel" value="Zweites Gesetz zur Änderung des Gesetzes zur Ausführung des Zweiten Buches Sozialgesetzbuch und zur Ausführung der Aufgaben nach § 6 b des Bundeskindergeldgesetzes" />
			<string key="DokNr" value="16/2995" />
			<string key="Abstract" value="Abfederung der Kostenlast der Kommunen durch den Auswuchs von Leistungsberechtigten in Folge der Fluchtmigration seit dem Jahr 2015 durch Erhöhung der Bundesbeteiligung an den Kosten, insbesondere Ermöglichung einer vorläufigen Abschlagszahlung an die Kommunen auf die zusätzliche Bundesbeteiligung an den Kosten der Unterkunft und Heizung von Leistungsberechtigten nach dem Zweiten Buch Sozialgesetzbuch (SGB II) nach den allgemeinen Maßgaben des Landesrechts, nachträglicher Ausgleich der zusätzlichen Leistungen der Kreise für die Kosten der Unterkunft des betroffenen Personenkreises" />
			<string key="Urheber" value="Landesregierung" />
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP16/Drucksachen/2000/16_2995_D.pdf" />
