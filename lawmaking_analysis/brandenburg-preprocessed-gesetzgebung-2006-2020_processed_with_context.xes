			<string key="Desk" value="Landesaufnahmegesetz" />
			<string key="Titel" value="Gesetz über die Aufnahme von Flüchtlingen, spätausgesiedelten und weiteren aus dem Ausland zugewanderten Personen im Land Brandenburg sowie zur Durchführung des Asylbewerberleistungsgesetzes (Landesaufnahmegesetz - LAufnG)" />
			<string key="DokNr" value="06/3080" />
			<string key="Su" value="46" />
			<string key="Urheber" value="Landesregierung" />
			<string key="LokURL" value="https://www.parlamentsdokumentation.brandenburg.de/parladoku/w6/drs/ab_3000/3080.pdf" />
			<string key="FundSt" value="Brandenburg -  Gesetzentwurf (LReg) 27.11.2015 Drucksache 6/3080 (46 S.)" />
			<string key="NrInTyp" value="nan" />
			<string key="Sb" value="nan" />
			<string key="BText" value="nan" />
			<string key="Redner" value="nan" />
			<string key="VkDat" value="NaT" />
			<string key="HNr" value="nan" />
			<string key="Jg" value="NaT" />
			<string key="Abstract" value="Neufassung des Landesaufnahmegesetzes; Anpassung an veränderte bundes- und europarechtliche Regelungen zur Aufnahme, Unterbringung und Versorgung von Flüchtlingen (landesrechtliche Umsetzung der novellierten EU-Aufnahmerichtlinie RL 2013/32/EU und von Änderungen des Asylbewerberleistungsgesetzes, Vereinbarkeit mit internationalen Menschenrechtsabkommen) und Umsetzung politischer Willensäußerungen auf Landesebene; insbesondere veränderte Regelungen zur Aufgabenübertragung und Kostendeckungsregelungen für die Landkreise und kreisfreien Städte" />
			<string key="concept:name" value="Gesetzentwurf" />
